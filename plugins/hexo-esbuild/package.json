{
  "name": "hexo-esbuild",
  "version": "3.1.0",
  "description": "Transform JavaScript, CSS, TypeScript, and JSX files via esbuild transform API.",
  "keywords": [
    "hexo",
    "hexo-plugin",
    "plugin",
    "esbuild",
    "minify"
  ],
  "homepage": "https://github.com/uiolee/hexo-plugin/tree/main/plugins/hexo-esbuild",
  "bugs": {
    "url": "https://github.com/uiolee/hexo-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uiolee/hexo-plugin.git",
    "directory": "plugins/hexo-esbuild"
  },
  "license": "MPL-2.0",
  "author": "uiolee (https://github.com/uiolee)",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run tsbf",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:cov": "jest --coverage --coverageReporters html text",
    "test:lcov": "jest --coverage --coverageReporters lcovonly text-summary",
    "tsb": "tsc -b -v",
    "tsbf": "tsc -b -v -f",
    "tsbw": "tsc -b -v -w"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "micromatch": "^4.0.5"
  },
  "peerDependencies": {
    "esbuild": "^0.25.0",
    "micromatch": "^4.0.5"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": false
    },
    "micromatch": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
